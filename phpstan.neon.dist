includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:

    paths:
        - app

    # The level 9 is the highest level
    level: 5

    # Eloquent model attributes typed from the schema (e.g. a primary key) are
    # not actually guaranteed to be non-null at runtime (unsaved models), so do
    # not treat those PHPDoc types as certain when reporting always-true checks.
    treatPhpDocTypesAsCertain: false
